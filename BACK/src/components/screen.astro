---
import TextInput from "@/react-components/textInput";
---

<section class="screen-content">
  <div class="screen-content-konva" id="screen-content-konva"></div>
  <div class="screen-content-drawing" id="screen-content-drawing">
    <canvas
      class="screen-code-canvas"
      id="screen-code-canvas"
      width="20"
      height="20"></canvas>
    <canvas
      class="screen-drawing-canvas-to-show"
      id="screen-drawing-canvas-to-show"></canvas>
    <canvas class="screen-drawing-canvas" id="screen-drawing-canvas"></canvas>
  </div>
  <TextInput client:load />
</section>

<style>
  .screen-content {
    position: relative;
    width: 100dvw;
    height: 100dvh;
    overflow: hidden;
    background-image: url("/images/bg.svg");
    background-size: 20px 20px;
    background-position: 0 0;
  }

  .screen-content-drawing {
    position: absolute;
    top: 0;
    left: 0;
    width: 100dvw;
    height: 100dvh;
    overflow: hidden;
    z-index: 12;
    display: none;
    &.show {
      display: block;
    }
  }
  .screen-code-canvas {
    position: absolute;
    bottom: 0;
    left: 0;
    display: none;
    background-color: #ff0;
  }

  .screen-drawing-canvas-to-show {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
  }
  .screen-drawing-canvas {
    position: relative;
    display: block;
    opacity: 0;
  }

  .screen-content-konva.drawing-mode {
    opacity: 0.6;
  }
</style>

<script>
  import { StatusMode, showEditTools } from "@/js/store";
  import { STATUS_MODES } from "@/js/constants";

  const screenContentKonva = document.getElementById("screen-content-konva");
  const screenContentDrawing = document.getElementById(
    "screen-content-drawing"
  );

  StatusMode.subscribe((mode) => {
    if (mode === STATUS_MODES.DRAWING) {
      screenContentKonva.classList.add("drawing-mode");
      screenContentDrawing.classList.add("show");
    } else {
      screenContentKonva.classList.remove("drawing-mode");
      screenContentDrawing.classList.remove("show");
    }
  });
</script>
